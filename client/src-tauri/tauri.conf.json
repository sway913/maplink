{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapLink Client",
  "version": "0.5.0",
  "identifier": "io.frpmanager.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "映链 MapLink", "width": 1040, "height": 760, "minWidth": 720, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/FRP-LICENSE": "FRP-LICENSE"
    }
  }
}
