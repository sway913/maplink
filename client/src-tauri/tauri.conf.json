{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapLink Client",
  "version": "0.1.0",
  "identifier": "io.frpmanager.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "映链 MapLink", "width": 1040, "height": 760, "minWidth": 720, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/frpc.exe": "frpc.exe",
      "resources/FRP-LICENSE": "FRP-LICENSE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
